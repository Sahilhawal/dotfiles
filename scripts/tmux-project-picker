#!/usr/bin/env bash
# Floating project picker — fzf list of ~/code projects, opens/switches to tmux session
# 1-9: instantly pick by number

# Projects dir: ~/code (macOS) or ~/Code (Linux)
if [ -d "$HOME/code" ]; then
  projects_dir="$HOME/code"
else
  projects_dir="$HOME/Code"
fi

LIST_CMD="{ find $projects_dir -mindepth 1 -maxdepth 1 -type d; find $projects_dir/punch-web-worktrees -mindepth 1 -maxdepth 1 -type d 2>/dev/null; } | sort | cat -n"

selected=$(eval "$LIST_CMD" | \
  fzf --reverse \
    --header "  Projects — Enter: open/switch  |  1-9: instant pick" \
    --bind '1:pos(1)+accept' \
    --bind '2:pos(2)+accept' \
    --bind '3:pos(3)+accept' \
    --bind '4:pos(4)+accept' \
    --bind '5:pos(5)+accept' \
    --bind '6:pos(6)+accept' \
    --bind '7:pos(7)+accept' \
    --bind '8:pos(8)+accept' \
    --bind '9:pos(9)+accept' | \
  awk '{print $2}')

[[ -z "$selected" ]] && exit 0

session_name=$(basename "$selected" | tr . _)

if ! tmux has-session -t "$session_name" 2>/dev/null; then
  if [[ "$selected" == */punch-web-worktrees/* ]]; then
    host="$selected/punch-web"
    lib="$selected/finance-web-charts-library"
    root="$selected"

    tmux new-session -s "$session_name" -c "$host" -d -n "claude"
    tmux send-keys -t "$session_name:claude" "claude" Enter

    tmux new-window -t "$session_name" -n "lg-host" -c "$host"
    tmux send-keys -t "$session_name:lg-host" "lazygit" Enter

    tmux new-window -t "$session_name" -n "lg-lib" -c "$lib"
    tmux send-keys -t "$session_name:lg-lib" "lazygit" Enter

    tmux new-window -t "$session_name" -n "nvim" -c "$root"
    tmux send-keys -t "$session_name:nvim" "nvim ." Enter

    tmux new-window -t "$session_name" -n "dev" -c "$host"
    tmux split-window -t "$session_name:dev" -h -c "$lib"
    tmux select-pane -t "$session_name:dev.left"
  else
    tmux new-session -s "$session_name" -c "$selected" -d -n "claude"
    tmux send-keys -t "$session_name:claude" "claude" Enter

    tmux new-window -t "$session_name" -n "lazygit" -c "$selected"
    tmux send-keys -t "$session_name:lazygit" "lazygit" Enter

    tmux new-window -t "$session_name" -n "nvim" -c "$selected"
    tmux send-keys -t "$session_name:nvim" "nvim ." Enter

    tmux new-window -t "$session_name" -n "terminal" -c "$selected"
  fi

  tmux select-window -t "$session_name:claude"
fi

tmux switch-client -t "$session_name"
